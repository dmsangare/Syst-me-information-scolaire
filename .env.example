# ============================================================
# SIS-MALI â€” Environment Variables (PRODUCTION TEMPLATE)
# ============================================================
# Copier ce fichier vers .env et remplir les valeurs rÃ©elles.
# NE JAMAIS COMMITTER le .env rÃ©el.
# ============================================================

# --- Application ---
NODE_ENV=production
APP_NAME=SIS-MALI
APP_URL=http://votre-domaine.ml
# Version de l'application (utilisee par le healthcheck)
APP_VERSION=1.0.0
TZ=Africa/Bamako

# --- PostgreSQL ---
# âš ï¸  Changer le mot de passe sur chaque serveur
POSTGRES_DB=sis_mali
POSTGRES_USER=sis_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
POSTGRES_PORT=5432
DATABASE_URL=postgresql://sis_user:CHANGE_ME_STRONG_PASSWORD_HERE@postgres:5432/sis_mali?schema=public

# --- Redis ---
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# --- JWT ---
# âš ï¸  GÃ©nÃ©rer avec : openssl rand -hex 64
JWT_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_64

# URL publique pour QR codes et liens de verification
PUBLIC_URL=http://localhost
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_64_DIFFERENT
JWT_REFRESH_EXPIRES_IN=7d

# --- Security ---
BCRYPT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
LOCK_DURATION_MINUTES=15
RATE_LIMIT_PER_MINUTE=100

# --- Storage ---
STORAGE_ROOT=/app/storage
STORAGE_DOCUMENTS=/app/storage/documents
STORAGE_UPLOADS=/app/storage/uploads
STORAGE_BACKUPS=/app/storage/backups
STORAGE_GENERATED=/app/storage/generated
MAX_UPLOAD_SIZE_MB=10

# --- PDF ---
PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser
PDF_LOCALE=fr-FR

# --- Network ---
HTTP_PORT=80
HTTPS_PORT=443
# Port d'ecoute de l'API NestJS (fallback: 3000)
PORT=3000

# --- Backups ---
BACKUP_CRON=0 23 * * *
BACKUP_RETENTION_DAYS=7
BACKUP_RETENTION_WEEKS=4
BACKUP_RETENTION_MONTHS=12

# --- Notifications (optionnel) ---
SMS_PROVIDER_URL=
SMS_PROVIDER_KEY=
WHATSAPP_PROVIDER_URL=
WHATSAPP_PROVIDER_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@sis-mali.local

# --- Defaults ---
DEFAULT_COUNTRY=ML
DEFAULT_TIMEZONE=Africa/Bamako
DEFAULT_CURRENCY=FCFA
DEFAULT_LOCALE=fr-FR
FRONTEND_URL=http://votre-domaine.ml
# URL de l'API pour le proxy Vite en developpement (optionnel)
# En production, Nginx fait le reverse proxy : laisser vide.
VITE_API_TARGET=http://localhost:3000

# --- Seed (premiere installation uniquement) ---
# Super Admin : ce compte est cree AUTOMATIQUEMENT au premier lancement
# de install.sh. Remplis ces 4 valeurs AVANT de lancer install.sh.
# ATTENTION : note bien le mot de passe, il ne sera plus jamais affiche.
SUPER_ADMIN_EMAIL=admin@votre-domaine.ml
SUPER_ADMIN_FIRSTNAME=Super
SUPER_ADMIN_LASTNAME=Admin
# OBLIGATOIRE : mot de passe fort (12+ caracteres, majuscules + chiffres + symboles).
# Si laisse VIDE, install.sh refusera de demarrer.
SUPER_ADMIN_PASSWORD=

